{
  "name": "figqa",
  "version": "0.1.0",
  "description": "Design-system QA for Figma files, with no Figma. Lint a .fig offline and bind hard-coded colours to design tokens by writing the file back.",
  "scripts": {
    "lint": "node figqa.mjs lint",
    "vars": "node figqa.mjs vars",
    "fix": "node figqa.mjs fix"
  },
  "keywords": [
    "figma",
    "design-system",
    "design-tokens",
    "lint",
    "fig",
    "kiwi",
    "ci",
    "headless"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "fzstd": "^0.1.1",
    "kiwi-schema": "^0.5.0"
  },
  "bin": {
    "figqa": "./figqa.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}